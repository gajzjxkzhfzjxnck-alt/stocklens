{"id":6,"stock_id":98,"title":"Tempus AI Inc. 研究报告","filename":"TEM_1781483170010.html","rating":null,"summary":null,"source":"uploaded","created_at":"2026-06-15T08:26:10","html":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tempus AI (TEM) 深度投资价值研究报告</title>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js\"></script>\n<style>\n  :root{\n    --ink:#0e1b2c;          /* deep clinical navy */\n    --ink-soft:#33455c;\n    --paper:#f6f4ee;        /* warm bone */\n    --panel:#ffffff;\n    --line:#d9d3c4;\n    --helix:#1e7d6e;        /* teal — the \"data/AI\" spine */\n    --helix-dim:#5fa99c;\n    --blood:#c0392b;        /* oncology red — risk/diagnostics */\n    --gold:#b8860b;         /* valuation amber */\n    --slate:#64748b;\n    --good:#1e7d6e;\n    --bad:#c0392b;\n    --warn:#b8860b;\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  body{\n    font-family:\"Songti SC\",\"Noto Serif SC\",Georgia,serif;\n    background:var(--paper);\n    color:var(--ink);\n    line-height:1.75;\n    font-size:16px;\n  }\n  .wrap{max-width:960px;margin:0 auto;padding:0 22px 100px}\n\n  /* ---------- Hero ---------- */\n  .hero{\n    padding:60px 0 38px;\n    border-bottom:3px solid var(--ink);\n    position:relative;\n  }\n  .eyebrow{\n    font-family:\"PingFang SC\",\"Helvetica Neue\",sans-serif;\n    letter-spacing:.32em;font-size:12px;color:var(--helix);\n    text-transform:uppercase;font-weight:700;margin-bottom:18px;\n  }\n  .hero h1{\n    font-size:clamp(34px,6vw,60px);line-height:1.05;font-weight:800;\n    letter-spacing:-.01em;\n  }\n  .hero h1 .tick{color:var(--helix)}\n  .hero .sub{\n    margin-top:18px;font-size:18px;color:var(--ink-soft);max-width:640px;\n    font-family:\"PingFang SC\",sans-serif;\n  }\n  .snapshot{\n    display:grid;grid-template-columns:repeat(4,1fr);gap:1px;\n    background:var(--line);border:1px solid var(--line);margin-top:34px;\n  }\n  .snapshot div{background:var(--panel);padding:16px 14px}\n  .snapshot .k{font-family:\"PingFang SC\",sans-serif;font-size:11px;letter-spacing:.08em;color:var(--slate);text-transform:uppercase}\n  .snapshot .v{font-size:24px;font-weight:800;margin-top:5px}\n  .snapshot .v small{font-size:13px;font-weight:600;color:var(--ink-soft)}\n  .pos{color:var(--good)} .neg{color:var(--bad)}\n\n  /* ---------- verdict band ---------- */\n  .verdict{\n    margin-top:30px;background:var(--ink);color:#f6f4ee;\n    padding:26px 30px;border-radius:2px;\n  }\n  .verdict .label{font-family:\"PingFang SC\",sans-serif;font-size:12px;letter-spacing:.25em;color:var(--helix-dim);text-transform:uppercase}\n  .verdict .line{font-size:22px;font-weight:700;margin-top:8px;font-family:\"PingFang SC\",sans-serif}\n  .verdict p{margin-top:12px;font-size:15px;color:#cdd6da;font-family:\"PingFang SC\",sans-serif;line-height:1.7}\n\n  /* ---------- sections ---------- */\n  section{padding:54px 0;border-bottom:1px solid var(--line)}\n  .mod-no{\n    font-family:\"PingFang SC\",sans-serif;font-size:13px;font-weight:700;\n    color:var(--helix);letter-spacing:.2em;\n  }\n  h2{font-size:30px;font-weight:800;margin:6px 0 8px;letter-spacing:-.01em}\n  h3{font-size:20px;font-weight:700;margin:34px 0 12px;font-family:\"PingFang SC\",sans-serif;color:var(--ink)}\n  h3 .tag{font-size:12px;background:var(--helix);color:#fff;padding:2px 9px;border-radius:20px;vertical-align:middle;margin-left:8px;font-weight:600;letter-spacing:.05em}\n  p{margin:13px 0;font-family:\"PingFang SC\",sans-serif}\n  .lead{font-size:17px;color:var(--ink-soft)}\n  strong{color:var(--ink);font-weight:700}\n  em{font-style:normal;background:linear-gradient(transparent 62%,#f2e2b8 62%);padding:0 2px;font-weight:600}\n\n  /* ---------- tables ---------- */\n  .tbl-wrap{overflow-x:auto;margin:22px 0;border:1px solid var(--line)}\n  table{width:100%;border-collapse:collapse;font-family:\"PingFang SC\",sans-serif;font-size:14px;min-width:620px}\n  th,td{padding:11px 13px;text-align:right;border-bottom:1px solid var(--line)}\n  th:first-child,td:first-child{text-align:left;font-weight:600}\n  thead th{background:var(--ink);color:#f6f4ee;font-weight:600;letter-spacing:.03em;font-size:13px}\n  tbody tr:nth-child(even){background:#faf8f2}\n  tbody tr:hover{background:#f0ede3}\n  .num{font-variant-numeric:tabular-nums}\n\n  /* ---------- chart ---------- */\n  .chart-card{background:var(--panel);border:1px solid var(--line);padding:22px 22px 14px;margin:24px 0;border-radius:2px}\n  .chart-card h4{font-family:\"PingFang SC\",sans-serif;font-size:15px;font-weight:700;margin-bottom:4px}\n  .chart-card .cap{font-family:\"PingFang SC\",sans-serif;font-size:12.5px;color:var(--slate);margin-bottom:16px}\n  .chart-box{position:relative;height:330px}\n  .chart-box.tall{height:380px}\n\n  /* ---------- callouts ---------- */\n  .call{border-left:4px solid var(--helix);background:#eef5f3;padding:16px 20px;margin:22px 0;font-family:\"PingFang SC\",sans-serif;font-size:14.5px;border-radius:0 2px 2px 0}\n  .call.red{border-color:var(--blood);background:#fbeeec}\n  .call.gold{border-color:var(--gold);background:#f8f1de}\n  .call .h{font-weight:700;display:block;margin-bottom:6px;font-size:13px;letter-spacing:.05em;text-transform:uppercase}\n  .call.red .h{color:var(--blood)} .call .h{color:var(--helix)} .call.gold .h{color:var(--gold)}\n\n  /* ---------- moat scorecard ---------- */\n  .moat-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0}\n  .moat{background:var(--panel);border:1px solid var(--line);padding:18px;border-radius:2px}\n  .moat .title{font-family:\"PingFang SC\",sans-serif;font-weight:700;font-size:15px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}\n  .dots{display:inline-flex;gap:4px}\n  .dot{width:11px;height:11px;border-radius:50%;background:var(--line)}\n  .dot.on{background:var(--helix)}\n  .dot.on.r{background:var(--blood)}\n  .moat p{font-size:13.5px;margin:0;color:var(--ink-soft)}\n\n  /* ---------- trade zones ---------- */\n  .zones{margin:26px 0}\n  .zone{display:grid;grid-template-columns:140px 1fr;gap:0;border:1px solid var(--line);border-bottom:none;font-family:\"PingFang SC\",sans-serif}\n  .zone:last-child{border-bottom:1px solid var(--line)}\n  .zone .price{padding:18px;font-size:24px;font-weight:800;display:flex;flex-direction:column;justify-content:center;color:#fff}\n  .zone .price small{font-size:12px;font-weight:600;opacity:.85;margin-top:3px}\n  .zone .desc{padding:16px 20px;font-size:14px}\n  .zone .desc .zt{font-weight:700;margin-bottom:5px}\n  .z1 .price{background:var(--slate)}\n  .z2 .price{background:var(--helix)}\n  .z3 .price{background:var(--blood)}\n\n  /* ---------- compare matrix ---------- */\n  .legend{font-family:\"PingFang SC\",sans-serif;font-size:12px;color:var(--slate);margin-top:8px}\n\n  .foot{margin-top:40px;font-family:\"PingFang SC\",sans-serif;font-size:12px;color:var(--slate);line-height:1.7;border-top:1px solid var(--line);padding-top:20px}\n  .toc{font-family:\"PingFang SC\",sans-serif;display:flex;flex-wrap:wrap;gap:8px;margin-top:30px}\n  .toc a{font-size:12.5px;text-decoration:none;color:var(--ink-soft);border:1px solid var(--line);padding:6px 12px;border-radius:30px;transition:.2s}\n  .toc a:hover{background:var(--ink);color:#fff;border-color:var(--ink)}\n\n  @media(max-width:680px){\n    .snapshot{grid-template-columns:repeat(2,1fr)}\n    .moat-grid{grid-template-columns:1fr}\n    .zone{grid-template-columns:110px 1fr}\n    h2{font-size:24px}\n  }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n  <!-- ============ HERO ============ -->\n  <div class=\"hero\">\n    <div class=\"eyebrow\">买方深度研究 · BUY-SIDE DEEP DIVE</div>\n    <h1>Tempus AI <span class=\"tick\">(TEM)</span><br>把肿瘤数据炼成 AI 复利的赌局</h1>\n    <p class=\"sub\">一家伪装成诊断公司的\"医疗数据操作系统\"——高增长、强网络效应，但被股权激励与现金消耗反复稀释的故事。本报告穿透六大模块，给出真金白银验证与三档交易区间。</p>\n\n    <div class=\"snapshot\">\n      <div><div class=\"k\">现价 (6/6)</div><div class=\"v\">$48.2<small>/股</small></div></div>\n      <div><div class=\"k\">市值</div><div class=\"v\">~$8.7<small>B</small></div></div>\n      <div><div class=\"k\">2025 营收</div><div class=\"v\">$1.27<small>B (+83%)</small></div></div>\n      <div><div class=\"k\">P/S (TTM)</div><div class=\"v\">~6.4<small>x</small></div></div>\n      <div><div class=\"k\">2026E 营收</div><div class=\"v\">$1.59<small>–1.60B</small></div></div>\n      <div><div class=\"k\">毛利率</div><div class=\"v\">63.4<small>%</small></div></div>\n      <div><div class=\"k\">GAAP 净利</div><div class=\"v neg\">-$245<small>M</small></div></div>\n      <div><div class=\"k\">CEO 投票权</div><div class=\"v\">~60<small>%</small></div></div>\n    </div>\n\n    <div class=\"verdict\">\n      <div class=\"label\">一句话结论 · The Thesis</div>\n      <div class=\"line\">谨慎做多 / 估值已从泡沫回到\"可建仓\"区间</div>\n      <p>TEM 真正的资产不是检测试剂，而是覆盖 5,000+ 家机构、~1/4 美国肿瘤患者的多模态数据飞轮。诊断业务负责\"灌数据\"，数据业务负责\"提毛利、给估值乘数\"。但它仍在烧钱、股权激励吞噬利润、CEO 一票独大且持续减持——这是一笔\"赔率不错、但必须分批、且要盯紧现金与稀释\"的成长股下注，而非可以无脑重仓的复利机器。</p>\n    </div>\n\n    <nav class=\"toc\">\n      <a href=\"#m1\">① 财务验证</a>\n      <a href=\"#m2\">② 业务拆解 & TAM</a>\n      <a href=\"#m3\">③ 竞争格局 & 压力测试</a>\n      <a href=\"#m4\">④ 护城河</a>\n      <a href=\"#m5\">⑤ 管理层 & 资本分配</a>\n      <a href=\"#m6\">⑥ 估值 & 交易策略</a>\n    </nav>\n  </div>\n\n  <!-- ============ MODULE 1 ============ -->\n  <section id=\"m1\">\n    <div class=\"mod-no\">模块一 / FINANCIALS</div>\n    <h2>财务表现与真金白银验证</h2>\n    <p class=\"lead\">先看五年账，再戳穿三个最关键的\"成色\"问题：增长靠什么、利润率往哪走、扣掉 SBC 还剩多少。</p>\n\n    <div class=\"tbl-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>财年 (截至 12/31)</th>\n            <th>2021</th><th>2022</th><th>2023</th><th>2024</th><th>2025</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr><td>营业收入 ($M)</td><td class=\"num\">~232</td><td class=\"num\">321</td><td class=\"num\">532</td><td class=\"num\">693</td><td class=\"num\">1,272</td></tr>\n          <tr><td>收入增速 (YoY)</td><td class=\"num\">—</td><td class=\"num pos\">+38%</td><td class=\"num pos\">+66%</td><td class=\"num pos\">+30%</td><td class=\"num pos\">+83%</td></tr>\n          <tr><td>毛利率</td><td class=\"num\">~36%</td><td class=\"num\">40.6%</td><td class=\"num\">53.8%</td><td class=\"num\">55.0%</td><td class=\"num\">62.7%</td></tr>\n          <tr><td>营业利润 EBIT ($M)</td><td class=\"num neg\">—</td><td class=\"num neg\">-265</td><td class=\"num neg\">-196</td><td class=\"num neg\">-691*</td><td class=\"num neg\">-253</td></tr>\n          <tr><td>营业利润率</td><td class=\"num neg\">—</td><td class=\"num neg\">-83%</td><td class=\"num neg\">-37%</td><td class=\"num neg\">-100%</td><td class=\"num neg\">-20%</td></tr>\n          <tr><td>GAAP 净利润 ($M)</td><td class=\"num neg\">—</td><td class=\"num neg\">-289</td><td class=\"num neg\">-214</td><td class=\"num neg\">-706</td><td class=\"num neg\">-245</td></tr>\n          <tr><td>调整后 EBITDA ($M)</td><td class=\"num neg\">—</td><td class=\"num neg\">~-140</td><td class=\"num neg\">-154</td><td class=\"num neg\">-105</td><td class=\"num neg\">-7.4</td></tr>\n          <tr><td>经营现金流 ($M)</td><td class=\"num neg\">—</td><td class=\"num neg\">~-180</td><td class=\"num neg\">-168</td><td class=\"num neg\">-214</td><td class=\"num neg\">~-130</td></tr>\n          <tr><td>自由现金流 FCF ($M)</td><td class=\"num neg\">—</td><td class=\"num neg\">~-200</td><td class=\"num neg\">-202</td><td class=\"num neg\">-236</td><td class=\"num neg\">~-150</td></tr>\n        </tbody>\n      </table>\n    </div>\n    <p class=\"legend\">* 2024 EBIT/净利大幅恶化主要受 IPO 时点确认的一次性巨额股权激励费用（当年 SBC 约 $5.34 亿）拖累，属非现金、非经常项。2021 为估算值。FCF = 经营现金流 − 资本开支。数据来源：公司 10-K / 8-K / 年报。</p>\n\n    <div class=\"chart-card\">\n      <h4>营收高速增长 vs. 持续失血的现金流</h4>\n      <div class=\"cap\">柱：营收（左轴，$M）。线：调整后 EBITDA / 自由现金流（右轴，$M）。叙事很清楚——规模在跑，亏损在收窄，但 FCF 仍为负。</div>\n      <div class=\"chart-box tall\"><canvas id=\"c1\"></canvas></div>\n    </div>\n\n    <h3>问题一：增长是\"量增\"还是\"价涨\"？<span class=\"tag\">答：以量增为主</span></h3>\n    <p>核心引擎是<strong>检测放量 + 数据合同放量</strong>，而非提价。2025 诊断业务收入增长 111%（含 Ambry Genetics 并表），但拆开看，<em>肿瘤检测的单价（ASP）长期被压在 $17.2–17.4 区间，几乎没动</em>；增长来自肿瘤检测量 +26%、遗传检测量 +29%、MRD（微小残留病灶）检测量同比暴增约 5 倍。数据业务则靠合同数量与单笔规模双升——管理层披露已有\"半打\"大型药企签下单笔 $1 亿+ 的多年战略合作。<strong>这是健康的增长结构：先靠走量把数据池做大，价格弹性留作后手</strong>（多个 assay 拿到 FDA 批准 / ADLT 定价后，ASP 才会向上重定价，这是 2026–27 的潜在期权）。</p>\n\n    <h3>问题二：利润率在改善还是恶化？<span class=\"tag\">答：持续、显著改善</span></h3>\n    <p>这是 TEM 最漂亮的一条线。<em>毛利率从 2022 年的 ~41% 一路爬到 2025 年的 ~63%</em>，2026 Q1 进一步到 63.8%。驱动力有二：(1) 高毛利的数据 & 应用业务占比提升（数据业务毛利远高于湿实验室检测）；(2) 检测端规模效应 + 自动化。更关键的是营业杠杆——调整后 EBITDA 从 2023 年 -$1.54 亿收窄到 2025 年 -$740 万，<strong>2026 年指引首次给出约 +$6,500 万的正 EBITDA</strong>。这是\"亏损收窄→盈亏平衡→现金牛\"叙事链条上最有说服力的一段。</p>\n\n    <h3>问题三：扣掉 SBC，真实盈利能力打几折？<span class=\"tag red\">答：打骨折，这是最大暗雷</span></h3>\n    <div class=\"call red\">\n      <span class=\"h\">⚠ 股权激励 (SBC) 是这家公司的\"利润橡皮擦\"</span>\n      2025 全年 SBC + 相关工资税约 <strong>$1.36 亿</strong>，占营收约 <strong>11%</strong>；2026 Q1 单季就有 $5,630 万 SBC，占当季营收高达 <strong>16%</strong>。换句话说：公司引以为傲的\"调整后 EBITDA 转正\"，是建立在把这笔真实的股东稀释成本\"加回去\"的基础上的。<strong>用 GAAP 口径看，TEM 离真正盈利还很远</strong>——2026 Q1 GAAP 净亏损甚至扩大到 $1.26 亿（含 $3,230 万有价证券浮亏）。\n    </div>\n    <p>结论：TEM 的\"调整后\"盈利能力被 SBC 严重美化。买方视角必须把 SBC 当作真实成本——它每年稀释你 ~2–4% 的股权。好消息是 SBC 占比正随营收做大而下降（从 2024 的天量回落），坏消息是绝对额仍高、且 CEO 还在通过 10b5-1 计划持续卖出（见模块五）。<strong>盯住\"SBC 占营收比\"这条线能否在 2026–27 降到个位数，是判断管理层是否真把股东利益放心上的试金石。</strong></p>\n  </section>\n\n  <!-- ============ MODULE 2 ============ -->\n  <section id=\"m2\">\n    <div class=\"mod-no\">模块二 / SEGMENTS & TAM</div>\n    <h2>业务拆解与增量期权</h2>\n    <p class=\"lead\">TEM 是\"诊断（走量、灌数据）+ 数据应用（高毛利、给估值）\"的双轮飞轮。理解这个结构，才能理解它为什么敢叫自己\"AI 公司\"而非\"检测公司\"。</p>\n\n    <div class=\"chart-card\">\n      <h4>2025 营收结构：诊断是肉，数据是魂</h4>\n      <div class=\"cap\">诊断业务贡献 ~75% 收入（规模大、增速被并购放大），但数据 & 应用业务才是高毛利、给乘数估值的\"灵魂\"，且增速持续加速。</div>\n      <div class=\"chart-box\"><canvas id=\"c2\"></canvas></div>\n    </div>\n\n    <h3>核心存量：两大支柱</h3>\n    <p><strong>① 诊断 (Diagnostics)，2025 约 $9.55 亿，占比 ~75%。</strong>包括肿瘤 NGS 基因检测（xT/xF/xR）、遗传检测（并购 Ambry Genetics 而来）、MRD 液体活检。客户是医院、肿瘤科医生——典型 B 端 KA，但单次检测靠保险/Medicare 报销，带有\"按次收费\"的交易属性。产品生命周期处于<em>放量中前期</em>：多个 assay 正在走 FDA 审批与 ADLT 定价，量价齐升空间未释放。</p>\n    <p><strong>② 数据 & 应用 (Data & Applications)，2025 约 $3.16 亿，占比 ~25%，增速 +30.9% 且在加速。</strong>三块：Insights（向药企授权去标识化的临床-分子-影像多模态数据，毛利极高，增速 +38%）、Trials（临床试验匹配）、Next（AI 临床决策辅助平台）。客户是全球 95% 的头部药企——粘性强、多年合同、净收入留存率（NRR）高达 <strong>126%</strong>。<em>这块业务才是 TEM 估值溢价的真正来源。</em></p>\n\n    <h3>增量期权：下一代产品 <span class=\"tag\">爆发潜力</span></h3>\n    <p>TEM 的\"第二增长曲线\"押注非常 AI-native：</p>\n    <p>• <strong>肿瘤基础大模型 (Foundation Model)。</strong>与 AstraZeneca、Pathos 合作\"构建肿瘤领域最大的基础模型\"，建立在其 ~500 PB 的多模态数据库上。模式正从\"卖数据\"升级为\"让药企在 Tempus 数据上训练专有模型\"——这是把一次性数据授权变成<em>平台级、可复利的 AI 协作</em>。<br>\n    • <strong>MRD 液体活检放量。</strong>2026 Q1 检测量同比 +500%，是诊断端弹性最大的单品。<br>\n    • <strong>Olivia 个人健康管家 App + 数字病理 (并购 Paige AI)。</strong>向 C 端与影像 AI 延伸，Paige Predict 可从标准 H&E 切片预测 16 种癌症的 123 个生物标志物。</p>\n\n    <h3>空间测算：TAM / SAM</h3>\n    <div class=\"call\">\n      <span class=\"h\">市场空间</span>\n      管理层与卖方普遍引用的口径：<strong>精准肿瘤诊断 TAM ~$600 亿+</strong>（美国），其中可服务的肿瘤 NGS + 遗传检测 SAM 约 <strong>$200–250 亿</strong>；<strong>药企真实世界数据 / AI 模型市场（Insights）TAM 数百亿美元且高速扩张。</strong>TEM 当前 ~$13 亿营收，在 NGS 肿瘤检测中市占率约 20%——<em>渗透率仍低，跑道很长。</em>\n    </div>\n    <p>性质判断：<strong>诊断端是\"零和抢份额\"（与 Guardant、Caris、Foundation Medicine 贴身肉搏），数据/AI 端则更接近\"创造新蓝海\"</strong>——因为没有竞争对手拥有同等规模的纵向多模态数据，药企要训模型几乎绕不开它。这正是 TEM 区别于纯检测公司的关键。</p>\n  </section>\n\n  <!-- ============ MODULE 3 ============ -->\n  <section id=\"m3\">\n    <div class=\"mod-no\">模块三 / COMPETITION & STRESS TEST</div>\n    <h2>竞争格局与外部压力测试</h2>\n\n    <h3>行业生态位</h3>\n    <p class=\"lead\">一句话：<strong>TEM 是肿瘤精准医疗里唯一\"检测 + 数据 + AI\"全栈打通的玩家，在数据维度是事实上的领跑者，但在单点检测业务上仍是红海中的强者之一。</strong></p>\n\n    <h3>核心竞争对手优劣势矩阵</h3>\n    <div class=\"tbl-wrap\">\n      <table>\n        <thead>\n          <tr><th>公司</th><th>主战场</th><th>相对优势</th><th>相对劣势</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>Tempus (TEM)</td><td style=\"text-align:left\">全栈：检测+数据+AI</td><td style=\"text-align:left\">数据规模与多模态最广；药企关系最深（覆盖95%头部药企）；AI 飞轮</td><td style=\"text-align:left\">仍在烧钱；SBC 高；单点检测无绝对技术领先</td></tr>\n          <tr><td>Guardant Health</td><td style=\"text-align:left\">液体活检 / MRD</td><td style=\"text-align:left\">液体活检技术与专利领先；已对 TEM 发起专利诉讼</td><td style=\"text-align:left\">数据广度与药企数据变现不及 TEM</td></tr>\n          <tr><td>Foundation Medicine</td><td style=\"text-align:left\">组织 NGS（Roche 子公司）</td><td style=\"text-align:left\">背靠罗氏、资金雄厚、品牌成熟</td><td style=\"text-align:left\">独立性受限；AI/数据平台叙事弱</td></tr>\n          <tr><td>Caris Life Sciences</td><td style=\"text-align:left\">全面分子检测 + 数据</td><td style=\"text-align:left\">与 TEM 模式最像（检测+数据库）；已上市</td><td style=\"text-align:left\">规模与药企覆盖略逊</td></tr>\n          <tr><td>Natera</td><td style=\"text-align:left\">cfDNA / MRD（Signatera）</td><td style=\"text-align:left\">MRD 龙头、Signatera 商业化领先、已现金流转正</td><td style=\"text-align:left\">非全栈数据平台；肿瘤组织检测覆盖窄</td></tr>\n        </tbody>\n      </table>\n    </div>\n    <div class=\"call red\">\n      <span class=\"h\">⚠ 法律风险：开业当天就被告</span>\n      值得记住的细节——TEM 上市<strong>首日即遭 Guardant Health 就液体活检（xF/xM）发起专利诉讼</strong>。S-1 中也坦承竞争对手拥有更成熟的专利组合。液体活检是 TEM 弹性最大的增长点，也恰恰是它专利地基最薄、最易被狙击的地方。\n    </div>\n\n    <h3>极端压力测试：低成本 / 去中心化冲击</h3>\n    <p>你最关心的\"中国制造降维打击 / 开源破坏式创新\"框架，在 TEM 身上的传导路径有两条：</p>\n    <p><strong>(1) 测序成本坍塌（这是真实威胁）。</strong>基因测序的边际成本持续下降（Illumina、华大智造 MGI 的低价测序仪），<em>会把\"检测\"这件事本身商品化（commoditize），压缩诊断端毛利</em>。这正是为什么 TEM 拼命往数据/AI 上层走——它默认了底层检测终将白菜化，要靠上层数据资产收税。<br>\n    <strong>(2) 开源 AI 模型（双刃剑）。</strong>开源医疗大模型降低了\"建模\"门槛，但<em>模型不值钱，喂模型的高质量纵向标注数据才值钱</em>。开源越普及，TEM 的 500 PB 专有数据反而越稀缺、越值钱。</p>\n    <div class=\"call\">\n      <span class=\"h\">反制手段：它的护城河恰好对冲了低成本冲击</span>\n      面对降维打击，TEM 的三道防线是：<strong>① 数据规模壁垒</strong>（竞品砸钱也无法一夜复制十年积累的多模态患者数据）；<strong>② 高转换成本</strong>（医生工作流嵌入 + 药企多年合同）；<strong>③ 闭环生态</strong>（检测→数据→AI→反哺检测）。结论：成本坍塌伤的是它的\"检测皮肤\"，伤不到它的\"数据骨头\"。\n    </div>\n  </section>\n\n  <!-- ============ MODULE 4 ============ -->\n  <section id=\"m4\">\n    <div class=\"mod-no\">模块四 / MOAT ANALYSIS</div>\n    <h2>竞争壁垒与护城河深浅</h2>\n    <div class=\"call gold\" style=\"margin-top:24px\">\n      <span class=\"h\">综合评级：窄护城河，正在加宽（Narrow, Widening）</span>\n      TEM 还没到\"宽护城河\"——它仍在烧钱、单点检测可被替代、面临诉讼。但它的<strong>数据网络效应 + 转换成本</strong>是真实且罕见的，且随规模复利加宽。给一个\"窄偏宽\"的评级，核心来源是数据无形资产与转换成本。\n    </div>\n\n    <div class=\"moat-grid\">\n      <div class=\"moat\">\n        <div class=\"title\">网络效应 <span class=\"dots\">\n          <span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot\"></span></span></div>\n        <p><strong>强（4/5）。</strong>检测越多→数据越多→AI 模型越准→对医生与药企越有用→吸引更多检测。这是教科书式的数据飞轮，且是<em>跨边网络</em>（医生侧 ↔ 药企侧）。NRR 126% 是网络效应的财务证据。</p>\n      </div>\n      <div class=\"moat\">\n        <div class=\"title\">转换成本 <span class=\"dots\">\n          <span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot\"></span></span></div>\n        <p><strong>强（4/5）。</strong>检测一旦嵌入医生工作流（双向集成到诊室桌面），订单>5 次后 12 个月留存率 ~87%；药企签的是多年期、$1 亿+ 战略合同，迁移=推倒重来。</p>\n      </div>\n      <div class=\"moat\">\n        <div class=\"title\">无形资产 <span class=\"dots\">\n          <span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot on\"></span><span class=\"dot on\"></span></span></div>\n        <p><strong>极强（5/5）——这是真正的护城河源头。</strong>~500 PB 多模态数据库（基因+影像+临床结局）无法被资本快速复制；这是 TEM 区别于所有同行的稀缺资产。专利端反而是<em>弱项</em>（被 Guardant 起诉）。</p>\n      </div>\n      <div class=\"moat\">\n        <div class=\"title\">成本优势 <span class=\"dots\">\n          <span class=\"dot on r\"></span><span class=\"dot on r\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span></span></div>\n        <p><strong>弱（2/5）。</strong>检测端规模效应正在显现（毛利率爬升），但相对 Roche/Illumina 这种巨头并无结构性成本优势；底层测序成本还在被第三方持续压低。这是它最薄的一块。</p>\n      </div>\n    </div>\n    <p>结论：TEM 的护城河<strong>本质是\"数据+转换成本\"，而非\"成本+专利\"</strong>。这决定了它的投资属性——它是个数据平台 / 准 SaaS，而非传统诊断耗材股。这也是模块六估值重塑的逻辑起点。</p>\n  </section>\n\n  <!-- ============ MODULE 5 ============ -->\n  <section id=\"m5\">\n    <div class=\"mod-no\">模块五 / GOVERNANCE & CAPITAL ALLOCATION</div>\n    <h2>管理层治理与资本分配</h2>\n\n    <h3>利益绑定：创始人一票独大 <span class=\"tag red\">治理双刃剑</span></h3>\n    <p>CEO 兼创始人兼董事长 <strong>Eric Lefkofsky</strong>（连续创业者，因妻子罹患乳腺癌而创立 Tempus）通过<em>双层股权结构</em>牢牢控盘：Class B 股每股 30 票，其合计投票权约 <strong>60%</strong>（2025 年初一度达 62.4%）。基薪仅 $80 万，2024 年获 $2,775 万 RSU 授予——<strong>薪酬高度股票化，与股价深度绑定（利益一致的正面）。</strong></p>\n    <div class=\"call red\">\n      <span class=\"h\">⚠ 两个治理红旗</span>\n      <strong>(1) 绝对控制权：</strong>Lefkofsky 一人决定董事提名与重大事项，小股东几乎没有制衡能力，公司还保留了未来转为\"受控公司\"豁免的权利。<strong>(2) 持续减持：</strong>其关联实体（Blue Media、Gray Media 等）通过 10b5-1 计划<em>常态化卖出</em>——2026 年 1 月在 $65–66 区间卖出十余万股，2026 年 5 月又在 ~$51 卖出 16.6 万股。虽是预设计划、不构成内幕交易，但创始人在高位持续套现，是需要警惕的信号。\n    </div>\n\n    <h3>资金运用：研发 + 并购双线，偏激进</h3>\n    <p>管理层赚到（或融到）的钱主要花在两处：</p>\n    <p>• <strong>大力研发（正面）。</strong>持续重投 AI 与基础模型，研发是其叙事核心，且能看到营业杠杆改善的回报。<br>\n    • <strong>积极并购（中性偏激进）。</strong>2025 年完成多笔收购：Ambry Genetics（遗传检测，约 $3.75 亿现金对价）、Paige AI（数字病理）、OneOme。<em>并购确实拉高了营收增速并扩充数据资产，但也是 2025 投资活动现金流出近 $4 亿、商誉/无形资产暴增的主因，并稀释了\"内生增长\"的纯度。</em></p>\n    <div class=\"call\">\n      <span class=\"h\">资本分配评分：B−</span>\n      <strong>无分红、无回购</strong>（仍在烧钱阶段，这合理——成长期公司不该回购）。资金投向研发与并购的逻辑自洽，并购也确实买到了战略资产。扣分项：并购密集导致账面被商誉填充、内生增速被掩盖；且公司仍依赖发债（2025 年发行 $7.5 亿可转债）与潜在股权融资，<em>稀释风险尚未解除</em>。判断管理层成色的关键看点：能否在 2026–27 真正实现 GAAP 层面的自我造血，停止\"烧钱-融资\"循环。\n    </div>\n  </section>\n\n  <!-- ============ MODULE 6 ============ -->\n  <section id=\"m6\">\n    <div class=\"mod-no\">模块六 / VALUATION & TRADING STRATEGY</div>\n    <h2>周期定位、估值判断与交易策略</h2>\n\n    <h3>投资属性定性：结构性成长股（带高波动外壳）</h3>\n    <p class=\"lead\">TEM <strong>不是周期股</strong>——它的需求来自癌症诊断与药物研发，与宏观周期弱相关。但它有<em>\"高波动外壳\"</em>：Beta 高达 ~3.3、短仓比例高、估值对利率与 AI 情绪极度敏感。本质是\"结构性成长股 + 情绪放大器\"。</p>\n\n    <h3>估值重塑：拐点已经发生了一半</h3>\n    <p>你问的\"从周期股切换到 SaaS/平台化乘数估值的拐点到了吗\"——<strong>答案是：市场已经给了它平台股的估值乘数（P/S ~6.4x），但还没给到顶级 SaaS 的乘数。</strong>原因是它的收入里仍有 ~75% 是\"按次报销、毛利中等\"的诊断业务，拖低了整体估值锚。<em>真正的重估催化剂，是数据/应用业务占比持续提升 + 整体毛利率突破 65–70% + GAAP 转正</em>——一旦市场确信它是\"披着诊断外衣的数据平台\"，乘数有望向 8–10x EV/Sales 重估。这个拐点正在路上，但尚未完全兑现。</p>\n\n    <div class=\"chart-card\">\n      <h4>EV/Sales 估值带：从 IPO 泡沫回落到\"可建仓\"中枢</h4>\n      <div class=\"cap\">TEM 上市以来 NTM EV/Sales 在约 4x–15x 间剧烈波动。当前 ~6.4x（TTM P/S）位于历史区间偏下分位，估值泡沫已大幅出清。</div>\n      <div class=\"chart-box\"><canvas id=\"c3\"></canvas></div>\n    </div>\n\n    <h3>估值锚点</h3>\n    <p>因仍亏损，P/E 无意义（前瞻 P/E 为负）。最合适的锚是 <strong>EV/Sales</strong>（高增长未盈利平台标准估值法）。</p>\n    <div class=\"tbl-wrap\">\n      <table>\n        <thead><tr><th>口径</th><th>数值</th><th>解读</th></tr></thead>\n        <tbody>\n          <tr><td>当前 P/S (TTM)</td><td class=\"num\">~6.4x</td><td style=\"text-align:left\">基于 ~$13.6 亿 TTM 营收</td></tr>\n          <tr><td>2026E EV/Sales</td><td class=\"num\">~5.3x</td><td style=\"text-align:left\">基于 $1.59–1.60B 指引</td></tr>\n          <tr><td>历史 EV/Sales 中枢</td><td class=\"num\">~7–8x</td><td style=\"text-align:left\">IPO 后均值，当前低于中枢</td></tr>\n          <tr><td>历史分位</td><td class=\"num\">~30–40%</td><td style=\"text-align:left\">估值处于偏低分位，安全边际改善</td></tr>\n          <tr><td>卖方目标价（17家均值）</td><td class=\"num\">~$66.5</td><td style=\"text-align:left\">隐含 ~+33% 上行，普遍\"Buy\"</td></tr>\n        </tbody>\n      </table>\n    </div>\n\n    <h3>交易区间设定 <span class=\"tag\">寻找绝对安全边际</span></h3>\n    <p>结合 ~$48 现价、$41.7 的 52 周低点、历史估值带与基本面，划三档（仅为基于公开数据的框架性区间，非投资建议）：</p>\n\n    <div class=\"zones\">\n      <div class=\"zone z1\">\n        <div class=\"price\">$45–52<small>遭遇战 / 合理建仓</small></div>\n        <div class=\"desc\">\n          <div class=\"zt\">利空出尽、可分批打底仓</div>\n          对应 NTM EV/Sales ~5–5.5x，约等于当前价位。基本面（营收+36%、EBITDA 转正在即）已能支撑此估值，但 SBC 与现金流仍是悬顶之剑。<strong>策略：在此区间分 3–4 批建立底仓（不超过计划仓位的 40%），边走边验证 Q2/Q3 现金流与 SBC 占比。</strong>\n        </div>\n      </div>\n      <div class=\"zone z2\">\n        <div class=\"price\">$38–44<small>黄金买点 / 非对称暴利区</small></div>\n        <div class=\"desc\">\n          <div class=\"zt\">下行锁死、上行弹性巨大</div>\n          逼近并跌破 52 周低点（$41.7），对应 EV/Sales ~4–4.5x——这是平台型公司极少给到的\"地板估值\"，基本把诊断业务按耗材股、把数据业务白送。<strong>若因大盘系统性回调或单季 miss 误杀至此，是重仓区</strong>（前提：数据业务 NRR 仍 >115%、EBITDA 指引未下修）。\n        </div>\n      </div>\n      <div class=\"zone z3\">\n        <div class=\"price\">$28–35<small>终极防御 / 捡钱价格</small></div>\n        <div class=\"desc\">\n          <div class=\"zt\">极度恐慌 / 系统性崩盘</div>\n          对应 EV/Sales ~3x 或更低，仅在 AI 板块整体崩盘、或公司被迫大额股权再融资引发恐慌时出现。这是\"市场把它当一家普通亏损诊断公司\"定价的极限。<strong>真到这里且基本面无实质恶化，是十年一遇的赔率，但需有承受继续下跌 30% 的心理准备。</strong>\n        </div>\n      </div>\n    </div>\n\n    <h3>退出机制：什么信号该坚定止盈？</h3>\n    <div class=\"call red\">\n      <span class=\"h\">⚠ 见到以下任一信号，在高位坚决减仓 / 离场</span>\n      <strong>基本面恶化类：</strong>① 数据业务 NRR 跌破 110%（飞轮转速下降）；② 毛利率连续两季停滞或下滑（规模效应见顶 / 竞争压价）；③ SBC 占营收比不降反升（管理层用稀释买增长）；④ 管理层下修全年营收或 EBITDA 指引；⑤ 检测量增速显著放缓而 ASP 又未能接棒。<br><br>\n      <strong>估值/情绪类：</strong>⑥ NTM EV/Sales 重新冲上 12–15x（回到 IPO 泡沫区，无业绩支撑的纯情绪推动）；⑦ Lefkofsky 关联实体减持<em>明显加速</em>或转为非计划性抛售；⑧ 液体活检专利诉讼出现重大不利判决。\n    </div>\n\n    <div class=\"call gold\">\n      <span class=\"h\">最终交易结论</span>\n      <strong>谨慎做多，分批为王。</strong>当前 ~$48 处于\"合理建仓区\"上沿，估值泡沫已出清但未到\"捡钱\"。建议把它当作一笔<em>赔率不错的成长股期权</em>：在 $45–52 建 40% 底仓，把主力子弹（重仓）留给 $38–44 的非对称区。仓位上严控（鉴于 Beta 3.3+ 的剧烈波动），单一标的不宜超过组合的合理上限。核心验证变量按重要性排序：<strong>① 数据业务增速与 NRR → ② GAAP/现金流转正路径 → ③ SBC 稀释收敛 → ④ 液体活检诉讼。</strong>\n    </div>\n  </section>\n\n  <div class=\"foot\">\n    <strong>数据来源：</strong>Tempus AI 10-K / 10-Q / 8-K / 年报（SEC EDGAR）、公司 2025 Q4 & 全年与 2026 Q1 业绩公告、Yahoo Finance / Morningstar / CNBC / Stock Analysis 市场数据（截至 2026-06-06，现价约 $48.2，市值约 $87 亿）。历史 EV/Sales 估值带为基于公开市值与营收的估算示意，非精确逐日数据。<br><br>\n    <strong>重要声明：</strong>本报告为基于公开信息的研究框架与分析，<em>不构成任何投资建议、买卖要约或个性化财务建议</em>。文中所有价格区间均为框架性参考，不代表对未来股价的预测或保证。TEM 为高波动（Beta >3）、仍未盈利的成长股，下行风险显著。投资决策请结合自身风险承受能力并咨询持牌专业顾问。我不是持牌财务顾问。\n  </div>\n\n</div>\n\n<script>\nconst FONT = \"'PingFang SC', 'Helvetica Neue', sans-serif\";\nChart.defaults.font.family = FONT;\nChart.defaults.color = '#33455c';\nconst INK='#0e1b2c', HELIX='#1e7d6e', HELIXD='#5fa99c', BLOOD='#c0392b', GOLD='#b8860b', SLATE='#94a3b8';\n\n// ---- Chart 1: revenue vs EBITDA/FCF ----\nnew Chart(document.getElementById('c1'), {\n  data:{\n    labels:['2022','2023','2024','2025','2026E'],\n    datasets:[\n      {type:'bar', label:'营业收入 ($M)', data:[321,532,693,1272,1595], backgroundColor:HELIXD, borderColor:HELIX, borderWidth:1, yAxisID:'y', order:3, barPercentage:.62},\n      {type:'line', label:'调整后 EBITDA ($M)', data:[-140,-154,-105,-7.4,65], borderColor:GOLD, backgroundColor:GOLD, borderWidth:3, tension:.3, yAxisID:'y1', order:1, pointRadius:4, pointHoverRadius:6},\n      {type:'line', label:'自由现金流 FCF ($M)', data:[-200,-202,-236,-150,null], borderColor:BLOOD, backgroundColor:BLOOD, borderWidth:2.5, borderDash:[5,4], tension:.3, yAxisID:'y1', order:2, pointRadius:4, pointHoverRadius:6}\n    ]\n  },\n  options:{\n    responsive:true, maintainAspectRatio:false,\n    interaction:{mode:'index', intersect:false},\n    plugins:{legend:{position:'bottom', labels:{usePointStyle:true, padding:18, font:{size:12}}}},\n    scales:{\n      y:{position:'left', title:{display:true,text:'营收 ($M)'}, grid:{color:'#e8e3d6'}, ticks:{callback:v=>v.toLocaleString()}},\n      y1:{position:'right', title:{display:true,text:'EBITDA / FCF ($M)'}, grid:{drawOnChartArea:false}, ticks:{callback:v=>v}}\n    }\n  }\n});\n\n// ---- Chart 2: 2025 revenue mix ----\nnew Chart(document.getElementById('c2'), {\n  type:'doughnut',\n  data:{\n    labels:['诊断 Diagnostics ($955M)','数据&应用 Insights等 ($316M)'],\n    datasets:[{data:[955,316], backgroundColor:[INK, HELIX], borderColor:'#f6f4ee', borderWidth:3, hoverOffset:8}]\n  },\n  options:{\n    responsive:true, maintainAspectRatio:false, cutout:'58%',\n    plugins:{\n      legend:{position:'bottom', labels:{usePointStyle:true, padding:18, font:{size:13}}},\n      tooltip:{callbacks:{label:c=>` ${c.label}: $${c.parsed}M (${(c.parsed/1271*100).toFixed(0)}%)`}}\n    }\n  }\n});\n\n// ---- Chart 3: EV/Sales band ----\nnew Chart(document.getElementById('c3'), {\n  type:'line',\n  data:{\n    labels:['IPO 24Q3','24Q4','25Q1','25Q2','25Q3','25Q4','26Q1','现在'],\n    datasets:[\n      {label:'NTM EV/Sales (示意)', data:[9,7,6.5,8.5,12,14.5,7.5,6.4], borderColor:HELIX, backgroundColor:'rgba(30,125,110,.10)', borderWidth:3, tension:.35, fill:true, pointRadius:4, pointBackgroundColor:HELIX},\n      {label:'历史中枢 ~7.5x', data:[7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5], borderColor:GOLD, borderWidth:2, borderDash:[6,5], pointRadius:0, tension:0},\n      {label:'地板估值 ~4x', data:[4,4,4,4,4,4,4,4], borderColor:BLOOD, borderWidth:1.5, borderDash:[3,4], pointRadius:0, tension:0}\n    ]\n  },\n  options:{\n    responsive:true, maintainAspectRatio:false,\n    interaction:{mode:'index', intersect:false},\n    plugins:{legend:{position:'bottom', labels:{usePointStyle:true, padding:16, font:{size:12}}}},\n    scales:{y:{title:{display:true,text:'EV / Sales (x)'}, grid:{color:'#e8e3d6'}, suggestedMin:2, suggestedMax:16}}\n  }\n});\n</script>\n</body>\n</html>\n"}