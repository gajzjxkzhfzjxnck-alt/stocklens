{"id":75,"stock_id":5,"title":"Meta Platforms Inc. 研究报告","filename":"META_1785367964474.html","rating":null,"summary":null,"source":"uploaded","model":null,"cost":null,"created_at":"2026-07-30T07:32:44","html":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>AI Capex 剪刀差实测：META / MSFT / GOOGL</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js\"></script>\n<style>\n  :root{\n    --bg:#0E1116; --bg2:#161B23; --bg3:#1D242E;\n    --line:#2A333F; --line2:#374252;\n    --fg:#E6EAF0; --fg2:#A7B0BE; --fg3:#6C7688;\n    --meta:#E8544A; --msft:#3DD68C; --googl:#4C8DFF;\n    --warn:#E5A83B;\n  }\n  *{box-sizing:border-box;}\n  body{margin:0;background:var(--bg);color:var(--fg);\n    font-family:\"IBM Plex Sans\",\"PingFang SC\",\"Microsoft YaHei\",\"Noto Sans SC\",sans-serif;\n    font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased;}\n  .wrap{max-width:1000px;margin:0 auto;padding:0 22px;}\n  .mono{font-family:\"IBM Plex Mono\",monospace;font-variant-numeric:tabular-nums;}\n\n  header{padding:44px 0 32px;border-bottom:1px solid var(--line);}\n  .kicker{font-family:\"IBM Plex Mono\";font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--fg3);}\n  h1{font-size:clamp(26px,5vw,40px);font-weight:700;margin:12px 0 8px;letter-spacing:-.015em;line-height:1.2;}\n  .dek{color:var(--fg2);font-size:16px;max-width:720px;}\n\n  /* verdict strip: the one-night scoreboard */\n  .scoreboard{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin:28px 0 0;}\n  .sb{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:16px 18px;position:relative;overflow:hidden;}\n  .sb::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;}\n  .sb.m::before{background:var(--meta);} .sb.s::before{background:var(--msft);} .sb.g::before{background:var(--googl);}\n  .sb .tk{font-family:\"IBM Plex Mono\";font-size:12px;letter-spacing:.1em;color:var(--fg3);}\n  .sb .mv{font-family:\"IBM Plex Mono\";font-weight:600;font-size:30px;margin:4px 0 2px;}\n  .sb.m .mv{color:var(--meta);} .sb.s .mv{color:var(--msft);} .sb.g .mv{color:var(--googl);}\n  .sb .wy{font-size:13px;color:var(--fg2);line-height:1.5;}\n\n  section{padding:44px 0;border-bottom:1px solid var(--line);}\n  h2{font-size:clamp(20px,3.6vw,26px);font-weight:600;margin:0 0 6px;letter-spacing:-.01em;}\n  h3{font-size:17px;font-weight:600;margin:28px 0 6px;}\n  h3 .rk{font-family:\"IBM Plex Mono\";color:var(--fg3);font-size:13px;margin-right:8px;}\n  p{margin:12px 0;} \n  ul{margin:12px 0;padding-left:20px;} li{margin:7px 0;}\n  small,.src{color:var(--fg3);font-size:12.5px;}\n\n  .thesis{background:var(--bg3);border:1px solid var(--line2);border-left:3px solid var(--warn);\n    border-radius:0 10px 10px 0;padding:16px 20px;margin:16px 0 24px;}\n  .thesis b{color:var(--warn);}\n\n  .tbl-wrap{overflow-x:auto;margin:20px 0 6px;border:1px solid var(--line);border-radius:10px;}\n  table{border-collapse:collapse;width:100%;font-size:13.5px;background:var(--bg2);}\n  th,td{padding:10px 13px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap;}\n  th:first-child,td:first-child{text-align:left;white-space:normal;min-width:170px;\n    position:sticky;left:0;background:var(--bg2);z-index:1;}\n  thead th{background:var(--bg3);font-weight:600;font-family:\"IBM Plex Mono\";font-size:12.5px;letter-spacing:.04em;}\n  thead th:first-child{background:var(--bg3);}\n  thead th.cm{color:var(--meta);} thead th.cs{color:var(--msft);} thead th.cg{color:var(--googl);}\n  td.bad{color:var(--meta);font-weight:500;} td.good{color:var(--msft);font-weight:500;}\n  tr.hl td{background:#20272F;} tr.hl td:first-child{background:#20272F;}\n  tr.hl td:first-child{font-weight:600;}\n  .note-row td{text-align:left;white-space:normal;color:var(--fg3);font-size:12px;line-height:1.6;}\n\n  .chart-box{position:relative;height:400px;width:100%;margin:22px 0 8px;\n    background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:16px 14px 10px;}\n  .chart-box.sm{height:340px;}\n  .cap{font-size:12.5px;color:var(--fg3);margin:0 0 20px;}\n\n  .dim{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:16px 0;}\n  .dim .hd{display:flex;align-items:baseline;gap:12px;margin-bottom:4px;}\n  .dim .n{font-family:\"IBM Plex Mono\";font-size:26px;font-weight:600;color:var(--line2);line-height:1;}\n  .dim .t{font-size:16.5px;font-weight:600;}\n  .rank{font-family:\"IBM Plex Mono\";font-size:13px;margin-top:10px;padding-top:10px;border-top:1px solid var(--line);color:var(--fg2);}\n  .rank b{color:var(--meta);}\n\n  .port{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:16px 0;}\n  .port.s{border-left:3px solid var(--msft);} .port.m{border-left:3px solid var(--meta);} .port.g{border-left:3px solid var(--googl);}\n  .port h4{margin:0 0 6px;font-size:16px;}\n  .port .verdict{font-family:\"IBM Plex Mono\";font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px;}\n  .port.s .verdict{color:var(--msft);} .port.m .verdict{color:var(--meta);} .port.g .verdict{color:var(--googl);}\n\n  .disclaim{font-size:12px;color:var(--fg3);padding:28px 0 56px;line-height:1.7;}\n  @media(max-width:640px){body{font-size:15px;} .sb .mv{font-size:26px;}}\n</style>\n</head>\n<body>\n\n<header><div class=\"wrap\">\n  <div class=\"kicker\">框架实测 · AI CAPEX 剪刀差</div>\n  <h1>同一晚，MSFT +7%，Meta −10%</h1>\n  <p class=\"dek\">2026年7月29日盘后，三家超大规模厂商的财报把\"AI 资本开支剪刀差\"这个框架推到了可验证的位置。结论：框架成立，但需要从\"一个比率\"升级为\"四个维度\"。</p>\n  <div class=\"scoreboard\">\n    <div class=\"sb s\"><div class=\"tk\">MSFT · FY26 Q4</div><div class=\"mv\">+7%</div><div class=\"wy\">Azure 加速到 43%，下季指引 45%；RPO $6,780亿</div></div>\n    <div class=\"sb g\"><div class=\"tk\">GOOGL · Q2'26（7/22）</div><div class=\"mv\">−3.7% → 次日 −7%</div><div class=\"wy\">Cloud +82%，但 FCF 转负、capex 指引升到 $2,050亿</div></div>\n    <div class=\"sb m\"><div class=\"tk\">META · Q2'26</div><div class=\"mv\">−10%</div><div class=\"wy\">营收减速、FCF 归零、拒绝给 2027 capex 指引</div></div>\n  </div>\n</div></header>\n\n<section><div class=\"wrap\">\n  <h2>一、横向对比表（口径统一：截至 2026年6月30日的当季）</h2>\n  <p class=\"src\">MSFT 为其 FY2026 Q4（自然季同为 4–6月），三家可直接对比。</p>\n\n  <div class=\"tbl-wrap\">\n  <table>\n    <thead><tr>\n      <th>指标</th><th class=\"cm\">META</th><th class=\"cs\">MSFT</th><th class=\"cg\">GOOGL</th>\n    </tr></thead>\n    <tbody>\n      <tr><td>营业收入</td><td>$608.0亿</td><td>$900.1亿</td><td>$1,198.0亿</td></tr>\n      <tr><td>营收同比</td><td>+28%</td><td>+18%</td><td>+24%</td></tr>\n      <tr class=\"hl\"><td>增速方向（二阶导）</td>\n        <td class=\"bad\">↓ 减速<br><small>33%→28%→22%(指引)</small></td>\n        <td class=\"good\">↑ 加速<br><small>Azure 40%→43%→45%(指引)</small></td>\n        <td class=\"good\">↑ 加速<br><small>Cloud 48%→63%→82%</small></td></tr>\n      <tr><td>营业利润</td><td>$188亿（−8%）</td><td>约$405亿（估）</td><td>$408亿（+30%）</td></tr>\n      <tr class=\"hl\"><td>营业利润率 & 方向</td>\n        <td class=\"bad\">31%（调整后~37%）<br><small>同比 −12pp</small></td>\n        <td>约45%（估）<br><small>大致持平</small></td>\n        <td class=\"good\">34%<br><small>同比 +2pp（扩张）</small></td></tr>\n      <tr><td>单季资本开支</td><td>$310.8亿</td><td>$410亿（含融资租赁）</td><td>$449.2亿</td></tr>\n      <tr><td>capex 同比</td><td>约 +80%（估）</td><td>+69%</td><td>+100%</td></tr>\n      <tr class=\"hl\"><td>capex / 营收（花钱强度）</td>\n        <td class=\"bad\">51%</td><td>46%</td><td class=\"good\">37%</td></tr>\n      <tr class=\"hl\"><td>自由现金流</td>\n        <td class=\"bad\">$7.8亿</td><td class=\"good\">$196.4亿（−23%）</td><td class=\"bad\">−$59亿</td></tr>\n      <tr><td>FCF 利润率</td><td class=\"bad\">1.3%</td><td class=\"good\">约22%</td><td class=\"bad\">负</td></tr>\n      <tr class=\"hl\"><td>收入可见性（backlog）</td>\n        <td class=\"bad\">无<br><small>广告为即期收入</small></td>\n        <td class=\"good\">RPO $6,780亿<br><small>≈ 年收入 2 倍</small></td>\n        <td class=\"good\">Cloud backlog $5,140亿<br><small>环比 +$500亿</small></td></tr>\n      <tr><td>全年 capex 指引</td><td>$1,250–1,450亿<br><small>区间收窄，保留上限</small></td><td>约$1,750亿<br><small>会计调整后</small></td><td>$1,950–2,050亿<br><small>上调</small></td></tr>\n      <tr class=\"hl\"><td>下一年 capex 指引</td>\n        <td class=\"bad\">拒绝提供</td>\n        <td class=\"good\">继续增长，但承诺 FY27 FCF 为正</td>\n        <td>\"显著增加\"</td></tr>\n      <tr><td>财报后股价反应</td><td class=\"bad\">−10%</td><td class=\"good\">+7%</td><td>−3.7% → 次日 −7%</td></tr>\n    </tbody>\n    <tbody class=\"note-row\">\n      <tr><td colspan=\"4\">口径说明：MSFT 营业利润未在本次公开报道中精确披露，按 Q3 FY26（$384亿/$829亿=46.3%）推算约 45%，标注为估算；净利润 $357.7亿、净利率 39.7% 为披露值，其中含 Anthropic 投资 $32亿收益。Meta 单季 capex 同比缺乏 Q2'25 精确基数，按 FY25 全年 $722亿分季推算，标注为估算。GOOGL 净利润 $1,121亿含约 $980亿股权未实现收益（Anthropic、SpaceX），不具可比性，故本表用营业利润。来源：各公司财报新闻稿与电话会记录（Meta 与 MSFT 为 2026-07-29，GOOGL 为 2026-07-22）、CNBC、Investing.com 转录。</td></tr>\n    </tbody>\n  </table>\n  </div>\n</div></section>\n\n<section><div class=\"wrap\">\n  <h2>二、最关键的一张图：加速还是减速</h2>\n  <div class=\"thesis\"><b>核心发现：</b>市场买的不是增速，是<b>加速度</b>。Meta 的营收增速已从 Q1 的 33% 峰值回落到 28%、指引 22%；而 MSFT 的 Azure 与 GOOGL 的 Cloud 都在<b>逐季加速</b>。这一条差异，基本解释了同一晚 +7% 与 −10% 的分野。</div>\n  <div class=\"chart-box\"><canvas id=\"sg_trajectory\"></canvas></div>\n  <p class=\"cap\">图1 · AI 核心业务增速轨迹。Meta 用总营收（其 AI 投入无独立收入line）；MSFT 用 Azure 固定汇率增速；GOOGL 用 Google Cloud 增速。虚线段为公司指引/预期。</p>\n\n  <h2 style=\"margin-top:36px;\">三、剪刀差本体：营收增速 vs capex 增速</h2>\n  <div class=\"chart-box\"><canvas id=\"sg_gap\"></canvas></div>\n  <p class=\"cap\">图2 · 三家的成本端（capex）增速都显著快于收入端——剪刀差在<b>全行业扩大</b>，不是 Meta 独有。差别在于后面三个维度。</p>\n\n  <div class=\"chart-box sm\"><canvas id=\"sg_intensity\"></canvas></div>\n  <p class=\"cap\">图3 · 花钱强度（capex/营收）与现金流留存（FCF利润率）。Meta 是三家中<b>花钱强度最高（51%）而现金留存几乎为零（1.3%）</b>的组合。</p>\n\n  <div class=\"chart-box sm\"><canvas id=\"sg_backlog\"></canvas></div>\n  <p class=\"cap\">图4 · 收入可见性。MSFT 与 GOOGL 用合约把未来收入锁住；Meta 的广告收入是即期的，backlog 为零。</p>\n</div></section>\n\n<section><div class=\"wrap\">\n  <h2>四、框架升级：从\"一个比率\"到\"四个维度\"</h2>\n  <p>你原来的框架问的是：<b>AI 收入增速是否在向 capex 增速收敛？</b>这一季的数据说明，光看这个比率会得出错误结论——按\"营收增速÷capex增速\"排，Meta 的 0.35 反而好于 MSFT 的 0.26 和 GOOGL 的 0.24，<b>但 Meta 跌最多。</b>缺的是下面三个维度。</p>\n\n  <div class=\"dim\">\n    <div class=\"hd\"><span class=\"n\">01</span><span class=\"t\">花钱强度 · capex / 营收</span></div>\n    <p style=\"margin:6px 0;\">最基础的一阶指标：每 100 块收入要投多少资本。Meta 51%、MSFT 46%、GOOGL 37%。</p>\n    <div class=\"rank\">排序：GOOGL 37% → MSFT 46% → <b>META 51%（最差）</b></div>\n  </div>\n\n  <div class=\"dim\">\n    <div class=\"hd\"><span class=\"n\">02</span><span class=\"t\">加速度 · 增速的二阶导</span></div>\n    <p style=\"margin:6px 0;\">市场给估值给的是变化率的方向。Azure 40→43→45（指引）、Cloud 48→63→82，都在加速；Meta 33→28→22，在减速。这是唯一能解释\"MSFT 营收增速 18% 最低却涨 7%\"的变量。</p>\n    <div class=\"rank\">排序：GOOGL / MSFT 加速 → <b>META 减速（最差）</b></div>\n  </div>\n\n  <div class=\"dim\">\n    <div class=\"hd\"><span class=\"n\">03</span><span class=\"t\">可见性 · backlog 与久期错配</span></div>\n    <p style=\"margin:6px 0;\">这是我上一份报告没讲透的一点。MSFT 有 RPO $6,780亿（约年收入 2 倍）、GOOGL 有 Cloud backlog $5,140亿——都是已签约但未确认的收入。Meta 的广告收入<b>零 backlog</b>：capex 是 5–10 年的不可逆承诺，收入能见度只有 90 天。<b>这是结构性的久期错配</b>，也是为什么同样的 capex 数字，市场对 Meta 要求更高的风险折价。</p>\n    <div class=\"rank\">排序：MSFT（2倍年收入）→ GOOGL（$5,140亿）→ <b>META（零，最差）</b></div>\n  </div>\n\n  <div class=\"dim\">\n    <div class=\"hd\"><span class=\"n\">04</span><span class=\"t\">归因性 · capex 有没有直接买家</span></div>\n    <p style=\"margin:6px 0;\"><b>这是四个维度里最重要、也最少被讨论的一个。</b></p>\n    <ul style=\"margin:8px 0;\">\n      <li><b>MSFT / GOOGL：</b>capex → 建算力 → <b>直接卖给客户</b>。Azure 收入、Cloud 收入就是这笔 capex 的直接产出，ROI 可以被逐季观测、被 backlog 验证。</li>\n      <li><b>META：</b>capex → 建算力 → <b>自用</b>，希望提升广告推荐效率。中间没有任何一个客户为这笔算力付费。</li>\n    </ul>\n    <p style=\"margin:6px 0;\">这个结构差异推导出一个重要结论：<b>Meta 的 capex ROI 在会计上是不可单独归因的。</b>广告收入增长里有多少来自 AI、多少来自行业景气、多少来自 Reels 时长——永远无法干净拆分。</p>\n    <p style=\"margin:6px 0;\">所以 Susan Li 拒绝给 2027 capex 指引、扎克伯格连续两季给不出可量化的货币化 KPI，<b>可能不是不愿意给，而是结构上给不出。</b>这比\"管理层信心不足\"是个更坏的解释，因为它意味着这个疑问<b>不会因为下一季财报而消失</b>。</p>\n    <div class=\"rank\">排序：MSFT / GOOGL 可归因 → <b>META 不可归因（最差）</b></div>\n  </div>\n\n  <div class=\"thesis\" style=\"margin-top:26px;\"><b>四维度打分结果：META 在全部四项上排最后。</b>综合排序 <b style=\"color:var(--msft)\">MSFT</b> &gt; <b style=\"color:var(--googl)\">GOOGL</b> &gt; <b style=\"color:var(--meta)\">META</b>。这不是说 Meta 生意差——它的广告单价还在 +12%——而是说在\"AI capex 剪刀差\"这个特定框架里，它是三家中结构最脆弱的一个。</div>\n</div></section>\n\n<section><div class=\"wrap\">\n  <h2>五、警告：你的框架从这一季开始\"测不准\"了</h2>\n  <p>三家在同一个窗口做了同一类动作——<b>用会计与交易结构管理 capex 与折旧的报表呈现</b>：</p>\n  <div class=\"tbl-wrap\">\n  <table>\n    <thead><tr><th>公司</th><th>动作</th><th>报表效果</th></tr></thead>\n    <tbody>\n      <tr><td>MSFT</td><td>办公楼与数据中心折旧年限 <b>15年 → 25年</b>；未来更多数据中心租约由融资租赁改为<b>经营租赁</b></td><td>capex 口径从约 $1,900亿 降至约 <b>$1,750亿</b>；年折旧压力下降</td></tr>\n      <tr><td>META</td><td>与 BlackRock 设立 $140亿 El Paso 数据中心合资，<b>BlackRock 基金持股 80%</b></td><td>该笔 capex <b>出表</b>，报表 FCF 改善，义务转为长期承诺</td></tr>\n      <tr><td>GOOGL</td><td>6月融资：股权 $496亿 + 高级票据 $203亿 + 设立 $400亿 ATM 额度</td><td>用外部资本承接 capex，稀释换现金</td></tr>\n    </tbody>\n  </table>\n  </div>\n  <p><b>含义：</b>从 2026 下半年起，只盯现金流量表的 capex 行会系统性低估真实经济投入。你的剪刀差框架需要新增三个数据源：</p>\n  <ul>\n    <li><b>RPO / backlog</b>——衡量收入可见性，是判断 capex 是否\"有买家\"的唯一硬指标</li>\n    <li><b>折旧年限假设</b>（10-K 附注）——年限一改，EPS 就变，且不影响现金流；这是最容易被忽略的利润操纵空间</li>\n    <li><b>表外结构</b>（JV / SPV / 经营租赁承诺）——藏在附注的\"合同义务\"表里</li>\n  </ul>\n  <p class=\"src\">具体到 Meta：如果 Q3 财报出现\"capex 指引下调、同时宣布更多 SPV/JV\"，那不是好消息，是同一笔钱换了个位置。这是我认为目前定价最不充分的一点。</p>\n</div></section>\n\n<section><div class=\"wrap\">\n  <h2>六、对你组合的三条直接结论</h2>\n\n  <div class=\"port s\">\n    <div class=\"verdict\">MSFT · 逻辑兑现</div>\n    <h4>你持 307 股 @ $384 —— 框架给出正面信号</h4>\n    <p style=\"margin:6px 0;\">你自己把 <b>MSFT FY26 Q4 定为剪刀差框架的下一个关键信号</b>。结果全面偏正：Azure 从 40% <b>加速到 43%</b>（一致预期 40%），下季指引 <b>45%</b>（一致预期 41.4%）；Azure 全年首破 $1,000亿、+41%；RPO $6,780亿 ≈ 年收入 2 倍；M365 Copilot 付费座席破 3,000万；Hood 明确<b>承诺 FY27 仍为 FCF 正</b>。会计调整还把 capex 口径压到约 $1,750亿。</p>\n    <p style=\"margin:6px 0;\">盘后 +7%（约 $425 附近），相对你 $384 成本浮盈约 11%。<b>这一季的读数支持\"持有/加仓\"，而非减仓。</b>唯一要盯的是折旧年限调整带来的 EPS 增益属于会计性质、不是经营改善，估值时应当剔除。</p>\n  </div>\n\n  <div class=\"port m\">\n    <div class=\"verdict\">META · 维持 🟡 观察名单</div>\n    <h4>框架给出负面信号，且四个维度全部垫底</h4>\n    <p style=\"margin:6px 0;\">这份对比强化而非削弱我上一条的判断。Meta 不是生意变坏——广告单价 +12%、DAP 36亿、剔除一次性后营业利润仍 +9%——而是<b>在这个框架里结构最弱</b>：花钱强度最高（51%）、增速在减速、零 backlog、capex 无直接买家。</p>\n    <p style=\"margin:6px 0;\">关键是第 04 维度的推论：<b>它的 ROI 疑问不会因为下一季财报而自动消失。</b>所以\"等 Q3 财报给答案\"这个思路本身可能是错的——真正的解锁点是 <b>2027 capex 指引给出一个有上限的数字</b>，或者 Meta 开始把算力对外变现（那才会产生可归因的收入）。买点维持在 $440–470 起步、$390–420 才算有吸引力。</p>\n  </div>\n\n  <div class=\"port g\">\n    <div class=\"verdict\">GOOGL · 尚未进区间，但值得盯紧</div>\n    <h4>现价约 $325–337，你设的 295–320 还差一点</h4>\n    <p style=\"margin:6px 0;\">7月最低触及 <b>$314.90</b>，最接近时离你的区间上沿只差约 5 美元。它在框架里的位置介于两者之间：<b>可见性与归因性像 MSFT</b>（Cloud +82% 加速、backlog $5,140亿、Cloud 营业利润率翻三倍到 35.6%），<b>但现金流比 Meta 更难看</b>（FCF −$59亿、capex 指引升到 $2,050亿、2027 还要\"显著增加\"，且已动用股权融资 + ATM）。</p>\n    <p style=\"margin:6px 0;\">今日大盘 <b>道指 −1,100点上下、VIX +13%、Fed 按兵不动后长端利率跳升</b>，加上油价大涨——如果这个 risk-off 延续，$295–320 有机会给到。按你的框架，<b>GOOGL 在这三家里是\"质地第二、价格可能先到位\"的那个</b>，优先级我会放在 META 之前。</p>\n  </div>\n\n  <div class=\"thesis\" style=\"margin-top:24px;\"><b>一句话总括：</b>剪刀差框架成立，但要从<b>「比率」升级为「比率 × 加速度 × 可见性 × 归因性」</b>。按升级版打分，当前排序是 MSFT &gt; GOOGL &gt; META；而这三家共同的新风险是——它们都已经开始用会计和交易结构管理这个数字，所以框架的数据源必须从现金流量表扩展到附注。</div>\n</div></section>\n\n<div class=\"wrap\">\n  <p class=\"disclaim\">本文为研究分析，不构成投资建议；作者非持牌投资顾问。财务数据来自各公司官方财报新闻稿与电话会记录（META、MSFT：2026-07-29；GOOGL：2026-07-22）及 CNBC、Investing.com 转录报道。表中标注\"估\"的项目为推算值，口径说明见表下注释。股价为盘中/盘后数据，波动剧烈，请以实时行情为准。数据整理时间：2026-07-30。</p>\n</div>\n\n<script>\nwindow.addEventListener('load', function(){\n  if (typeof Chart === 'undefined') return;\n  Chart.defaults.font.family = \"'IBM Plex Sans','PingFang SC','Microsoft YaHei','Noto Sans SC',sans-serif\";\n  Chart.defaults.font.size = 12;\n  Chart.defaults.color = '#A7B0BE';\n  var META='#E8544A', MSFT='#3DD68C', GOOGL='#4C8DFF', WARN='#E5A83B',\n      GRID='rgba(255,255,255,0.07)', FG='#E6EAF0';\n\n  function mk(id,cfg){\n    try{\n      var el=document.getElementById(id); if(!el) return;\n      new Chart(el.getContext('2d'), cfg);\n    }catch(e){ console.error('chart '+id, e); }\n  }\n\n  // Fig 1 — growth trajectory (the acceleration point)\n  mk('sg_trajectory', {\n    type:'line',\n    data:{ labels:['两季前','上一季','本季','下季(指引)'],\n      datasets:[\n        { label:'MSFT · Azure 增速', data:[39,40,43,45], borderColor:MSFT, backgroundColor:MSFT,\n          borderWidth:3, tension:.25, pointRadius:5, segment:{borderDash:function(c){return c.p1DataIndex===3?[6,4]:undefined;}} },\n        { label:'GOOGL · Cloud 增速', data:[48,63,82,null], borderColor:GOOGL, backgroundColor:GOOGL,\n          borderWidth:3, tension:.25, pointRadius:5 },\n        { label:'META · 总营收增速', data:[24,33,28,22], borderColor:META, backgroundColor:META,\n          borderWidth:3, tension:.25, pointRadius:5, segment:{borderDash:function(c){return c.p1DataIndex===3?[6,4]:undefined;}} }\n      ] },\n    options:{ responsive:true, maintainAspectRatio:false,\n      plugins:{ legend:{position:'bottom',labels:{color:FG,usePointStyle:true,pointStyle:'line'}},\n        title:{display:true,text:'图1 · 加速 vs 减速：市场买的是二阶导（同比增速 %）',color:FG,font:{size:13,weight:'600'}} },\n      scales:{ y:{ min:0, max:90, grid:{color:GRID}, ticks:{callback:function(v){return v+'%';}} },\n               x:{ grid:{color:GRID} } } }\n  });\n\n  // Fig 2 — the scissors: revenue growth vs capex growth\n  mk('sg_gap', {\n    type:'bar',\n    data:{ labels:['META','MSFT','GOOGL'],\n      datasets:[\n        { label:'营收增速 %', data:[28,18,24], backgroundColor:'rgba(76,141,255,0.85)', borderRadius:5 },\n        { label:'capex 增速 %', data:[80,69,100], backgroundColor:'rgba(232,84,74,0.85)', borderRadius:5 }\n      ] },\n    options:{ responsive:true, maintainAspectRatio:false,\n      plugins:{ legend:{position:'bottom',labels:{color:FG}},\n        title:{display:true,text:'图2 · 剪刀差本体：成本端增速全面快于收入端（%）',color:FG,font:{size:13,weight:'600'}} },\n      scales:{ y:{ beginAtZero:true, max:110, grid:{color:GRID}, ticks:{callback:function(v){return v+'%';}} },\n               x:{ grid:{display:false} } } }\n  });\n\n  // Fig 3 — intensity vs cash retention\n  mk('sg_intensity', {\n    type:'bar',\n    data:{ labels:['META','MSFT','GOOGL'],\n      datasets:[\n        { label:'capex / 营收 %', data:[51,46,37], backgroundColor:'rgba(229,168,59,0.85)', borderRadius:5 },\n        { label:'FCF 利润率 %', data:[1.3,21.8,-4.9], backgroundColor:'rgba(61,214,140,0.85)', borderRadius:5 }\n      ] },\n    options:{ responsive:true, maintainAspectRatio:false,\n      plugins:{ legend:{position:'bottom',labels:{color:FG}},\n        title:{display:true,text:'图3 · 花钱强度 vs 现金留存（%）',color:FG,font:{size:13,weight:'600'}} },\n      scales:{ y:{ min:-15, max:60, grid:{color:GRID}, ticks:{callback:function(v){return v+'%';}} },\n               x:{ grid:{display:false} } } }\n  });\n\n  // Fig 4 — revenue visibility\n  mk('sg_backlog', {\n    type:'bar',\n    data:{ labels:['META','MSFT','GOOGL'],\n      datasets:[{ label:'已签约未确认收入 backlog（十亿美元）',\n        data:[0,678,514], backgroundColor:[META,MSFT,GOOGL], borderRadius:5 }] },\n    options:{ indexAxis:'y', responsive:true, maintainAspectRatio:false,\n      plugins:{ legend:{display:false},\n        title:{display:true,text:'图4 · 收入可见性：Meta 的 backlog 是零（十亿美元）',color:FG,font:{size:13,weight:'600'}} },\n      scales:{ x:{ beginAtZero:true, grid:{color:GRID}, title:{display:true,text:'$B',color:'#6C7688'} },\n               y:{ grid:{display:false} } } }\n  });\n});\n</script>\n</body>\n</html>\n"}